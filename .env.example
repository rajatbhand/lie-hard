# Serverless (no-server) BACKUP app — talks directly to Firestore.
# Copy to .env.local (dev), .env.staging, or .env.production and fill in.
# All NEXT_PUBLIC_* values are baked into the client bundle at build time.

# ── Firebase: use the SHARED project `lie-hard-live` (same as the server app) ──
# This is what makes user data + game state carry over on a mid-show switch:
# both apps read/write the same Firestore + Auth. Copy these values from the
# lie-hard-live project console (Project settings -> Your apps -> Web app).
# The apiKey is a public project id, not a secret.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=lie-hard-live.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=lie-hard-live
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# NOTE: this backup has NO server, so there is deliberately NO NEXT_PUBLIC_WS_URL.
# It syncs game state directly through Firestore gameState/live — the same doc
# the server mirrors to — so scores/rounds resume exactly when you switch.
