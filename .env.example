# Serverless (no-server) BACKUP app — talks directly to Firestore.
# Copy to .env.local (dev), .env.staging, or .env.production and fill in.
# All NEXT_PUBLIC_* values are baked into the client bundle at build time.
# The build scripts read these via env-cmd (e.g. build:production -> .env.production).

# ── Firebase (project: lie-hard) ────────────────────────────────────────────
# From Firebase console -> Project settings -> General -> Your apps (Web app).
# apiKey is a public project id, not a secret.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=lie-hard.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=lie-hard
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# NOTE: this backup has NO server, so there is deliberately NO NEXT_PUBLIC_WS_URL.
# Game state syncs directly through Firestore.
