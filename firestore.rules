rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Game state — operator panel has no auth, so keep this open
    match /gameState/{document} {
      allow read, write: if true;
    }

    // Voter registration — each user can read/write ONLY their own doc.
    // (Previously this also had `read, delete: if true`, which made every
    // attendee's name + phone world-readable/deletable. Removed to close that
    // PII hole; the operator's "delete user data" clears votes/scores from
    // gameState instead of listing the voters collection.)
    match /voters/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

  }
}
